{
  "schemaVersion": 1,
  "id": "io.github.xjaike.google-drive",
  "name": "Google Drive",
  "version": "2.1.0",
  "author": "xJaike; interface by Homin Luo and Wesley Cole",
  "license": "MIT",
  "description": "Google Drive panel using a standalone Drive API backend with offline files, selective folders, and live transfer details.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Google Drive",
    "description": "Offline Google Drive files with direct API sync and per-file progress.",
    "category": "Files",
    "aliases": [
      "google-drive",
      "gdrive",
      "drive",
      "drive-sync"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "syncIntervalMin": 1,
      "refreshIntervalSec": 5
    },
    "schema": [
      {
        "key": "syncIntervalMin",
        "type": "integer",
        "label": "Sync interval (minutes)",
        "min": 1,
        "max": 1440,
        "step": 1,
        "defaultValue": 1
      },
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Status refresh (seconds)",
        "min": 1,
        "max": 3600,
        "step": 1,
        "defaultValue": 5
      }
    ]
  }
}
