#!/usr/bin/env bash
set -euo pipefail
state="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy-drive-sync"
mkdir -p "$state"
exec 9>"$state/run.lock"
flock -n 9 || exit 0
plugin_root="$(cd -- "$(dirname -- "$(readlink -f -- "$0")")/.." && pwd)"
status_helper="$plugin_root/status.py"
record_status() {
  python3 "$status_helper" record "$@" || true
}
finish() {
  result=$?
  trap - EXIT
  if (( result == 0 )); then record_status success 0
  else record_status error "$result"
  fi
  exit "$result"
}
trap finish EXIT
trap 'exit 143' TERM
trap 'exit 130' INT
if [[ -f "$state/current.jsonl" ]]; then mv -f "$state/current.jsonl" "$state/previous.jsonl"; fi
: > "$state/current.jsonl"
record_status running
if [[ ! -d "$HOME/GoogleDrive" ]] || mountpoint -q "$HOME/GoogleDrive"; then
  echo '~/GoogleDrive must be an ordinary local directory.' >&2
  exit 1
fi
args=(bisync "$HOME/GoogleDrive" 'omarchy-drive:Omarchy'
  --workdir "$state/bisync" --drive-skip-gdocs
  --create-empty-src-dirs --resilient --recover --check-access
  --backup-dir1 "$state/backups/$(date +%Y%m%dT%H%M%S)"
  --backup-dir2 "omarchy-drive:Omarchy-sync-backups/$(date +%Y%m%dT%H%M%S)"
  --contimeout 15s --timeout 2m --retries 2 --verbose
  --stats 1s --stats-file-name-length 0 --use-json-log
  --log-file "$state/current.jsonl" --log-file-max-size 10M --log-file-max-backups 1)
prepare_access_check() {
  # Keep a known file on both sides, including when there are no user files.
  touch "$HOME/GoogleDrive/RCLONE_TEST"
  rclone copyto "$HOME/GoogleDrive/RCLONE_TEST" 'omarchy-drive:Omarchy/RCLONE_TEST' \
    --ignore-existing --contimeout 15s --timeout 2m --retries 2
}
case "${1:-}" in
  --initialize)
    if [[ -f "$state/initialized" ]]; then
      echo 'Already initialized; run omarchy-drive-sync for a normal sync.'
      exit 1
    fi
    prepare_access_check
    rclone "${args[@]}" --resync --resync-mode path2
    touch "$state/initialized"
    ;;
  --repair)
    archive="$state/repairs/$(date +%Y%m%dT%H%M%S)"
    mkdir -p "$archive"
    if [[ -d "$state/bisync" ]]; then cp -a "$state/bisync" "$archive/"; fi
    prepare_access_check
    # One explicit recovery, merging both trees. Replaced versions go to backups.
    rclone "${args[@]}" --resync --resync-mode newer
    touch "$state/initialized"
    ;;
  '')
    [[ -f "$state/initialized" ]] || { echo 'Run omarchy-drive-setup first.' >&2; exit 1; }
    rclone "${args[@]}"
    ;;
  *) echo 'Usage: omarchy-drive-sync [--initialize|--repair]' >&2; exit 2 ;;
esac
